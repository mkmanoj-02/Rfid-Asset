{
  "info": {
    "_postman_id": "a8f3c2e1-9b4d-4f6a-8e2c-reader-mgmt-api",
    "name": "RFID Asset — Readers & Floor Plan",
    "description": "Auth + Reader Locations, Zones, Readers, and Floor Plan APIs.\n\n1. Run **Auth → Login** first (saves `accessToken`).\n2. Other requests use Bearer `{{accessToken}}`.\n3. Create endpoints save returned ids into collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5004" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "readerLocationId", "value": "1" },
    { "key": "zoneId", "value": "1" },
    { "key": "readerId", "value": "1" },
    { "key": "antennaNumber", "value": "1" },
    { "key": "floorZoneId", "value": "1" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  if (data.accessToken) pm.collectionVariables.set('accessToken', data.accessToken);",
                  "  if (data.refreshToken) pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"administrator\",\n  \"password\": \"admin\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Public. Saves accessToken and refreshToken to collection variables.\nUpdate username/password if your local admin differs."
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  if (data.accessToken) pm.collectionVariables.set('accessToken', data.accessToken);",
                  "  if (data.refreshToken) pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/refresh-token"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Reader Locations",
      "description": "Catalog names for the reader Location dropdown (`reader_locations`).",
      "item": [
        {
          "name": "List locations",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/reader-locations"
          }
        },
        {
          "name": "Create location",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  if (data.id != null) pm.collectionVariables.set('readerLocationId', String(data.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Receiving dock\"\n}"
            },
            "url": "{{baseUrl}}/api/reader-locations",
            "description": "400 empty name · 409 duplicate (case-insensitive)"
          }
        },
        {
          "name": "Update location",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"North dock\"\n}"
            },
            "url": "{{baseUrl}}/api/reader-locations/{{readerLocationId}}",
            "description": "Renames location and updates readers still using the old name."
          }
        },
        {
          "name": "Delete location",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/reader-locations/{{readerLocationId}}",
            "description": "204. Clears location to empty string on readers that used that name."
          }
        }
      ]
    },
    {
      "name": "Zones",
      "description": "Catalog names for the reader Zone dropdown (`zones`). Not floor-plan rectangles.",
      "item": [
        {
          "name": "List zones",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/zones"
          }
        },
        {
          "name": "Create zone",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  if (data.id != null) pm.collectionVariables.set('zoneId', String(data.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"DOOR\"\n}"
            },
            "url": "{{baseUrl}}/api/zones"
          }
        },
        {
          "name": "Update zone",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"GATE\"\n}"
            },
            "url": "{{baseUrl}}/api/zones/{{zoneId}}",
            "description": "Renames zone and updates readers.zone_type still using the old name."
          }
        },
        {
          "name": "Delete zone",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/zones/{{zoneId}}",
            "description": "204. Clears zone_type to empty string on matching readers."
          }
        }
      ]
    },
    {
      "name": "Readers",
      "item": [
        {
          "name": "List readers",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/readers"
          }
        },
        {
          "name": "Get reader",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/readers/{{readerId}}"
          }
        },
        {
          "name": "Create reader",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  if (data.id != null) pm.collectionVariables.set('readerId', String(data.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dock 1\",\n  \"readerType\": \"IR-Reader\",\n  \"ipAddress\": \"192.168.1.20\",\n  \"port\": 2022,\n  \"location\": \"Receiving dock\",\n  \"zoneType\": \"DOOR\",\n  \"mode\": \"IN\",\n  \"antennaCount\": 4,\n  \"txPower\": 30,\n  \"readDuration\": 1000,\n  \"itemSeen\": 20,\n  \"itemSeenEnabled\": true,\n  \"antennas\": [\n    { \"number\": 1, \"txPower\": 30, \"enabled\": true },\n    { \"number\": 2, \"txPower\": 30, \"enabled\": true },\n    { \"number\": 3, \"txPower\": 30, \"enabled\": true },\n    { \"number\": 4, \"txPower\": 30, \"enabled\": true }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/readers",
            "description": "readerType: IR-Reader | 4-Port Reader\nmode: IN | OUT | MONITORING\nlocation / zoneType must match catalog names (or empty)."
          }
        },
        {
          "name": "Update reader",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dock 1\",\n  \"readerType\": \"4-Port Reader\",\n  \"ipAddress\": \"192.168.1.20\",\n  \"port\": 2022,\n  \"location\": \"North gate\",\n  \"zoneType\": \"GENERIC\",\n  \"mode\": \"OUT\",\n  \"antennaCount\": 2,\n  \"txPower\": 28,\n  \"readDuration\": 1000,\n  \"itemSeen\": 20,\n  \"itemSeenEnabled\": true,\n  \"antennas\": [\n    { \"number\": 1, \"txPower\": 28, \"enabled\": true },\n    { \"number\": 2, \"txPower\": 28, \"enabled\": false }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/readers/{{readerId}}",
            "description": "Does not write connectionStatus. Antenna rows rebuilt to antennaCount (keeps existing within range)."
          }
        },
        {
          "name": "Delete reader",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/readers/{{readerId}}",
            "description": "204. Antennas deleted with the reader."
          }
        },
        {
          "name": "Start reader",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/readers/{{readerId}}/start",
            "description": "Sets connectionStatus = CONNECTED"
          }
        },
        {
          "name": "Stop reader",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/readers/{{readerId}}/stop",
            "description": "Sets connectionStatus = DISCONNECTED"
          }
        },
        {
          "name": "Start all readers",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/readers/start-all"
          }
        },
        {
          "name": "Stop all readers",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/readers/stop-all"
          }
        },
        {
          "name": "Update reader placement",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placed\": true,\n  \"positionX\": 120,\n  \"positionY\": 80\n}"
            },
            "url": "{{baseUrl}}/api/readers/{{readerId}}/placement",
            "description": "Off map: { \"placed\": false, \"positionX\": 0, \"positionY\": 0 }\nWhen placed=true, copies current floor plan imageUrl onto the reader if set."
          }
        },
        {
          "name": "Update antenna placement",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placed\": true,\n  \"positionX\": 160,\n  \"positionY\": 90\n}"
            },
            "url": "{{baseUrl}}/api/readers/{{readerId}}/antennas/{{antennaNumber}}/placement"
          }
        }
      ]
    },
    {
      "name": "Floor Plan",
      "item": [
        {
          "name": "Get layout",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/floor-plan",
            "description": "Returns { imageUrl, zones[] }"
          }
        },
        {
          "name": "Upload image",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": [],
                  "description": "Select a JPG/PNG/WebP/GIF/SVG file (max 5MB). Field name must be `image`."
                }
              ]
            },
            "url": "{{baseUrl}}/api/floor-plan/image",
            "description": "multipart field name: image → 200 { imageUrl }"
          }
        },
        {
          "name": "Delete image",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/floor-plan/image",
            "description": "204. Clears image URL."
          }
        },
        {
          "name": "Create floor zone (DOOR)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  if (data.id != null) pm.collectionVariables.set('floorZoneId', String(data.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"DOOR\"\n}"
            },
            "url": "{{baseUrl}}/api/floor-plan/zones",
            "description": "Names: Door Zone, Door Zone 2… First at 80,80; each new shifts +24. Size 220×120."
          }
        },
        {
          "name": "Create floor zone (BIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  if (data.id != null) pm.collectionVariables.set('floorZoneId', String(data.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"BIN\"\n}"
            },
            "url": "{{baseUrl}}/api/floor-plan/zones"
          }
        },
        {
          "name": "Update floor zone",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"x\": 100,\n  \"y\": 120,\n  \"width\": 220,\n  \"height\": 120,\n  \"minimized\": false\n}"
            },
            "url": "{{baseUrl}}/api/floor-plan/zones/{{floorZoneId}}",
            "description": "Partial updates OK. Minimize only: { \"minimized\": true }"
          }
        },
        {
          "name": "Delete floor zone",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/floor-plan/zones/{{floorZoneId}}"
          }
        },
        {
          "name": "Save layout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/floor-plan/save",
            "description": "Copies the floor plan image URL onto every reader."
          }
        }
      ]
    }
  ]
}
